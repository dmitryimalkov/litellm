# Шаблон переменных окружения для mcp_bridge.py.
# Скопировать как .env, заполнить реальными значениями, не коммитить .env с секретами.

# --- OpenMetadata MCP-сервер (каталог) ---
# Меняется при переносе самого стенда OpenMetadata, к LLM-hub отношения не имеет.
OPENMETADATA_MCP_URL=http://10.0.0.7:8585/mcp
OPENMETADATA_TOKEN=__JWT_бота__  # OpenMetadata -> Settings -> Bots -> нужный бот -> Revoke/Generate token

# ============================================================================
# ТОЧКА СОПРЯЖЕНИЯ 1: LLM-HUB
# OpenAI-совместимый шлюз, который реально обслуживает инференс.
#
# Прод (cloud.ru): self-hosted LiteLLM на той же ВМ, что и мост.
# Dev: здесь может быть ДРУГОЙ LiteLLM-инстанс / другой шлюз — поменять
# только два значения ниже, код mcp_bridge.py трогать не нужно.
# ============================================================================
LLM_HUB_BASE_URL=http://127.0.0.1:4000/v1
LLM_HUB_API_KEY=__LITELLM_MASTER_KEY_или_virtual_key__

# ============================================================================
# ТОЧКА СОПРЯЖЕНИЯ 2: INFERENCE MODEL
# Имя модели (алиас) ровно так, как оно заведено в LLM-hub выше — не
# обязательно совпадает с именем модели у вендора.
#
# Прод: алиас "deepseek-v3.2", проксирующий на cloud.ru Foundation Models.
# Dev: может быть другой алиас — своя ML-модель, заведённая в LiteLLM/шлюзе.
# Важно: модель должна поддерживать OpenAI tool calling (function calling),
# иначе бот не сможет вызывать MCP-инструменты каталога.
# ============================================================================
INFERENCE_MODEL=deepseek-v3.2

# --- Необязательные параметры (можно не менять при переносе) ---
MCP_BRIDGE_MAX_STEPS=20
MCP_BRIDGE_PREVIEW_CHARS=800

# Скопируйте в .env и заполните. Файл .env в git НЕ коммитить.
OPENMETADATA_MCP_URL=http://10.0.0.7:8585/mcp
OPENMETADATA_TOKEN=<JWT бота OpenMetadata>
LLM_HUB_BASE_URL=http://127.0.0.1:4000/v1
LLM_HUB_API_KEY=<ключ LiteLLM>
INFERENCE_MODEL=deepseek-v4-flash

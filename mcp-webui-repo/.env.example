# MCP_BRIDGE_MAX_STEPS=20
# MCP_BRIDGE_LLM_TIMEOUT=120
# MCP_BRIDGE_TEMPERATURE=0.2
# MCP_BRIDGE_PSEUDO_RETRIES=2
# MCP_BRIDGE_PREVIEW_CHARS=800
